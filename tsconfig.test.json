{
  // Tests run in Node but import browser modules (the race engine, the socket) as well as server code,
  // so they get both sets of types. Server/client code itself is still checked against its own, stricter config.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["test", "server", "shared", "src/game", "src/net", "src/audio/controller.ts", "src/brand.ts", "src/components/race/Crowd.tsx", "src/components/DifficultyPicker.tsx"]
}
